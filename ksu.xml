<!--
  PixelOS 14 - Xiaomi Redmi Note 11 (spes) - KernelSU Manifest
  Branch: fourteen-ksu
  Kernel includes KernelSU Next integration for Linux 4.19.

  Usage:
    repo init -u https://github.com/cyabell/pixelos_spes -b fourteen -m ksu.xml
    repo sync -c -j$(nproc) --force-sync --no-clone-bundle --no-tags
    source build/envsetup.sh && breakfast spes && mka bacon -j$(nproc)
-->
